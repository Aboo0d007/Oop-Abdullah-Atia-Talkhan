public class JavaApplication81 {
    public static String extractDomain(String email)
    {
        email =email.trim();
        int p =email.indexOf('@');
        if(p==-1)
        {return"Invalid Enail";
        
        }
        String d=email.substring(p+1);
        d=d.toLowerCase();
        return d;
                
                
    }


