import java.util.Scanner;

class Test {
    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        
        System.out.println("Table size:");
        int n = scan.nextInt();
        
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n; j++) {
                System.out.print((long)i * j + " ");
            }
            System.out.println();
        }
    }
}
