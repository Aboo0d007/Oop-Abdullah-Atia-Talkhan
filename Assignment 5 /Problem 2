package com.mycompany.p2abdo;
import java.util.*;
public class Proplem2 {
    public static void main(String[] args) { 
        Scanner in = new Scanner(System.in);
        char[][] board = new char[3][3];
        System.out.print("Enter 9 cells (X or O): ");
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                board[i][j] = Character.toUpperCase(in.next().charAt(0));
            }
        }

        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                System.out.print(board[i][j] + " ");
            }
            System.out.println();
        }

        int countX = 0;
        int countO = 0;
        for (int i = 0; i < 3; i++) 
        {
            for (int j = 0; j < 3; j++) 
            {
                if (board[i][j] == 'X')
                {
                    countX++;
                }
                if (board[i][j] == 'O') 
                {
                    countO++;
                }
            }
        }
        System.out.println("X count: " + countX);
        System.out.println("O count: " + countO);

        boolean found = false;
        for (int i = 0; i < 3; i++) {
            if (board[i][0] == 'X' &&board[i][1] == 'X' &&board[i][2] == 'X')
            {
                found = true;
            }
        }
        if (found) 
        {
            System.out.println("X has a full row");
        }
        else 
        {
            System.out.println("No full X row");
        }
    }
}
